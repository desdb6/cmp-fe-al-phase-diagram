&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   etot_conv_thr    = 1e-05
   forc_conv_thr    = 0.0005
   disk_io          = 'nowf'
   pseudo_dir       = '/scratch/antwerpen/213/vsc21316/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 120.0
   ecutrho          = 800.0
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   nspin            = 2
   starting_magnetization(1) = 0.0
   starting_magnetization(2) = 0.2
   ntyp             = 2
   nat              = 8
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press            = 0
   press_conv_thr   = 0.5
   cell_dofree      = 'all'
/
&FCP
/
&RISM
/
