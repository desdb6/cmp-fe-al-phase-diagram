&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 95.0
   ecutrho          = 500.0
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   nspin            = 2
   starting_magnetization(1) = 0.5
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
