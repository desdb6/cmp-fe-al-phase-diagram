&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 142.0
   ecutrho          = 1267.0
