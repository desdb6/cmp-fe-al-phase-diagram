&CONTROL
   calculation      = 'vc-relax'
   tstress          = .true.
   tprnfor          = .true.
   etot_conv_thr    = 1e-05
   forc_conv_thr    = 0.0005
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 142.0
   ecutrho          = 1500.0
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
/
&CELL
   press            = 0
   press_conv_thr   = 0.5
   cell_dofree      = 'all'
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Al 26.9815385 Al.us.pbe.z_3.ld1.psl.v1.0.0-low

K_POINTS automatic
11 11 11  0 0 0

