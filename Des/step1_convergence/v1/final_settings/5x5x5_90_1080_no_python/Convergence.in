#* Fe7Al (12.5 at.% Al): spin-polarized PBE SCF convergence-test, vary ecutwfc/ecutrho first, then k-point mesh and compare
#* pressure, total energy and magnetisation.


&CONTROL
  calculation = 'scf',
  outdir      = '.',
  prefix      = 'Fe7Al',
  pseudo_dir  = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials', 
  verbosity   = 'low',
  tprnfor     = .true.,
  tstress     = .true.,
/

&SYSTEM
  ibrav       = 0,
  nat         = 8,
  ntyp        = 2,
  input_dft   = 'PBE',
  ecutwfc     = 90.0,
  ecutrho     = 1080.0,
  nspin       = 2,
  starting_magnetization(1) = 0.20,
  starting_magnetization(2) = 0.00,
  occupations = 'smearing',
  smearing    = 'mv',
  degauss     = 0.02,
/

&ELECTRONS
  conv_thr         = 1.0d-8,
  electron_maxstep = 200,
  mixing_beta      = 0.30,
/

ATOMIC_SPECIES
Fe  55.845  Fe.paw.pbe.z_16.ld1.psl.v0.2.1
Al  26.9815 Al.us.pbe.z_3.ld1.psl.v1.0.0-low

