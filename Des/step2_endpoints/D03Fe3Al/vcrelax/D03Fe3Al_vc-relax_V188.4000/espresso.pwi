&CONTROL
   calculation      = 'vc-relax'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0001
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 90
   ecutrho          = 1080
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   nspin            = 2
   starting_magnetization(1) = 0.5
   starting_magnetization(2) = 0.0
   ntyp             = 2
   nat              = 16
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press            = 0.0
   press_conv_thr   = 0.1
   cell_dofree      = 'all'
/
&FCP
/
&RISM
/
