&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 90
   ecutrho          = 1080
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
