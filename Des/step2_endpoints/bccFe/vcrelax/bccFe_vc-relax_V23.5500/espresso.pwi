&CONTROL
   calculation      = 'vc-relax'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0001
   pseudo_dir       = '/home/des/cmp-fe-al-phase-diagram/Pseudopotentials'
/
&SYSTEM
   ecutwfc          = 120
   ecutrho          = 1440
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mv'
   nspin            = 2
   starting_magnetization(1) = 2.5
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press            = 0.0
   press_conv_thr   = 0.1
   cell_dofree      = 'all'
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Fe  55.845 Fe.paw.pbe.z_16.ld1.psl.v0.2.1

K_POINTS automatic
6 6 6  0 0 0

CELL_PARAMETERS angstrom
